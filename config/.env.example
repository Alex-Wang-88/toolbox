TOOLBOX_API_KEY=your_api_key_here
TOOLBOX_API_URL=https://api.yunbloom.cn/v2/chat/completions/share?shareId=your_share_id
TOOLBOX_OUTPUT_FOLDER=output
SOLUTION_AGENT_API_KEY=your_solution_agent_api_key
SOLUTION_AGENT_API_URL=https://api.yunbloom.cn/v2/chat/completions/share?shareId=your_share_id
SOLUTION_AGENT_TIMEOUT=360
SOLUTION_AGENT_RETRIES=2

# 可选：AI 唱歌（Seed-VC）独立运行环境
# SINGING_VC_ROOT=tts_poc/Seed-VC
# SINGING_VC_PYTHON=tts_poc/venv_seed_vc/Scripts/python.exe
# SINGING_VC_CHECKPOINT=
# SINGING_VC_CONFIG=
# SINGING_VC_FP16=true
# 模型已缓存时默认强制离线（HF_HUB_OFFLINE=1），避免 huggingface.co 校验被墙导致转换失败；
# 首次运行需要联网下载权重时设为 1 放开网络访问。
# SINGING_VC_ALLOW_DOWNLOAD=0

# 可选：AI 唱歌原曲模式（Demucs 人声/伴奏分离）
# 默认复用 SINGING_VC_PYTHON；需要在该环境安装 demucs
# SINGING_SEPARATION_PYTHON=tts_poc/venv_gptsovits/Scripts/python.exe
# SINGING_SEPARATION_MODEL=htdemucs
# SINGING_SEPARATION_DEVICE=auto
# SINGING_SEPARATION_SEGMENT=7

# 可选：本地克隆引擎 GPT-SoVITS V5 独立运行环境（默认引擎）
# GPTSOVITS_VENV=tts_poc/venv_gptsovits/Scripts/python.exe
# 克隆引擎切换（gptsovits / cosyvoice3）运行时持久化在 app_data/tts_engine_settings.json，
# 也可通过 /api/tts/clone-engine 接口或主页 GPU 面板切换。

# 可选：视频生成（MiniMax H3 / ComfyUI）独立环境
# VIDEOGEN_VENV=videogen_poc/venv_comfy/Scripts/python.exe
# VIDEOGEN_COMFY_DIR=videogen_poc/ComfyUI
# VIDEOGEN_PORT=8188
#
# 运行档位（两机共用同一份代码，只切这一项；见 config/videogen_profiles.json）
#   full       台式 16GB / ROCm：官方 INT8 + 32B 编码器 + 双 VAE，输出带音轨
#   lowvram8g  笔记本 8GB / CUDA：W4A8 + 4B/ClipProj + int8 VAE，默认输出无声
# 不设置时默认 full。切换后按对应档位下权重：
#   .venv\Scripts\python.exe videogen_poc\download_weights.py --profile lowvram8g
# VIDEOGEN_PROFILE=lowvram8g
